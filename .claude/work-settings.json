{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(app/**)",
      "Edit(docs/spec/**)",
      "Edit(CONTEXT.md)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git shortlog *)",
      "Bash(git rm *)",
      "Bash(git ls-files *)",
      "Bash(git branch --show-current)",
      "Bash(git pull --ff-only)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push)",

      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue develop *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",

      "Bash(uv sync --directory app)",
      "Bash(uv sync --directory app *)",
      "Bash(uv lock --directory app)",
      "Bash(uv lock --directory app *)",
      "Bash(uv run --directory app pytest)",
      "Bash(uv run --directory app pytest *)",
      "Bash(uv run --directory app ruff check *)",
      "Bash(uv run --directory app ruff format *)",
      "Bash(uv run --directory app mypy)",
      "Bash(uv run --directory app mypy *)",
      "Bash(uv run --directory app lint-imports)",
      "Bash(uv run --directory app pip-licenses *)",

      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(sed -n *)",
      "Bash(date *)",
      "Bash(claude --version)",
      "Bash(curl * http://localhost:*)"
    ],
    "deny": [
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(docs/adr/**)",
      "Edit(docs/process/**)",
      "Edit(docs/templates/**)",

      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh pr ready*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh label*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)"
    ]
  }
}
